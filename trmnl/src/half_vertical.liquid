<div class="layout layout--col layout--stretch gap--xsmall">
  {% if latest_post %}
    <div class="item">
      <div class="content">
        <span class="label label--small">Latest post</span>
        <span class="value value--xsmall">{{ latest_post.title }}</span>
      </div>
    </div>

    {% if latest_post.description %}
      <div class="item">
        <div class="content">
          <span class="value value--xxsmall">{{ latest_post.description }}</span>
        </div>
      </div>
    {% endif %}

    <div class="divider--h"></div>
    <div class="item">
      <div class="content">
        <span class="value value--xxsmall">&#10084; {{ latest_post.favourite_count }} likes</span>
      </div>
      <div class="content">
        <span class="label label--small">&#128176; {{ latest_post.tip_count }} tips</span>
      </div>
    </div>

    {% if latest_post.media_url %}
      <img class="image image-dither rounded image-contain" height="140px" src="{{ trml.plugin_settings.custom_fields_values.url | default: 'https://redchef.vandijke.xyz' }}/uploads/{{ latest_post.thumbnail }}" />
    {% endif %}

    {% if comments.size > 0 %}
      <div class="divider--h"></div>
      {% for comment in comments %}
        {% if forloop.index <= 2 %}
          <div class="item">
            <div class="content">
              <span class="value value--xxsmall">{{ comment.username }}: {{ comment.body }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  {% else %}
    <div class="item">
      <div class="content">
        <span class="value value--xsmall">No post yet</span>
      </div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">RedChef</span>
</div>
