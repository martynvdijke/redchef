OIDC_ENABLED=false
OIDC_ISSUER_URL=https://authelia.vandijke.xyz
OIDC_CLIENT_ID=redchef
OIDC_REDIRECT_URL=https://redchef.vandijke.xyz/api/auth/oidc/callback
OIDC_SCOPES=openid email profile groups
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_CLIENT_SECRET=        # prefer the _FILE above; never commit secrets
OIDC_LOGOUT_URL=
# Comma-separated browser origins allowed to call the API cross-origin (default: same-origin only)
# CORS_ALLOWED_ORIGINS=https://app.example,https://admin.example
