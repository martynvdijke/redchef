OIDC_ENABLED=false
OIDC_ISSUER_URL=https://authelia.vandijke.xyz
OIDC_CLIENT_ID=redchef
OIDC_REDIRECT_URL=https://redchef.vandijke.xyz/api/auth/oidc/callback
OIDC_SCOPES=openid email profile groups
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_CLIENT_SECRET=        # prefer the _FILE above; never commit secrets

# Legal / Google Play (set these to real values before publishing)
# LEGAL_CONTROLLER_NAME=Red Copper Chef operator
# LEGAL_CONTACT_EMAIL=privacy@example.com
# LEGAL_CONTACT_ADDRESS=
# LEGAL_HOSTING_REGION=the European Union
# LEGAL_BASE_URL=https://redchef.vandijke.xyz
# GDPR details (leave unset to omit invented details from the legal pages)
# LEGAL_EU_REPRESENTATIVE=
# LEGAL_DPO_EMAIL=
# LEGAL_SUPERVISORY_AUTHORITY=

# Shared demo account (seeded on boot, advertised at /api/auth/config)
# When DEMO_USER_ENABLED is unset, the demo account auto-enables only on
# redchef.vandijke.xyz. Set to false to disable it anywhere, true to force it on.
DEMO_USER_ENABLED=false
DEMO_USER_EMAIL=demo@redchef.local
DEMO_USER_PASSWORD=redchef-demo
OIDC_LOGOUT_URL=
# Comma-separated browser origins allowed to call the API cross-origin (default: same-origin only)
# CORS_ALLOWED_ORIGINS=https://app.example,https://admin.example

# OpenTelemetry (traces, metrics and logs). Opt-in: leave unset to disable.
# Any OTLP/HTTP endpoint enables all three signals; per-signal endpoints override it.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=redchef
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<token>
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_METRIC_EXPORT_INTERVAL=60000
